# --- Fairhours runtime configuration (copy to .env / compose env) ---
# Public URL of this instance
APP_URL=https://fairhours.malelu.io
# Database: Supabase Postgres (Transaction Pooler URI, port 6543) or any Postgres 15+
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Alternative for local dev/demo without Postgres: ZEITLY_DB=pglite (data in ./.data or in-memory)
ZEITLY_DB=postgres
ZEITLY_DEMO=0
# Secret for session cookies (>= 32 random chars). Generate: openssl rand -base64 48
SESSION_SECRET=
# Transactional mail (login codes, reminders, exports) via Resend
RESEND_API_KEY=
MAIL_FROM="Fairhours <notify@malelu.io>"
MAIL_REPLY_TO=office@malelu.io
# Operator contact shown in Impressum/Datenschutz
OPERATOR_NAME="MALELU AI – Peter Vitzthum"
OPERATOR_ADDRESS="Salzburg, Österreich"
OPERATOR_EMAIL=office@malelu.io
# Optional: AI helpers (document extraction in onboarding, monthly review narrative). Empty = disabled, app works without.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Production seed on first start: creates tenants MALELU AI + STEINERfood GmbH (owners, Manuela Behr as admin/first employee).
# Idempotent. Sends NO mails unless ZEITLY_SEED_SEND=1 – keep 0 until the pilot with STEINERfood is agreed;
# invitations are then sent by hand from Admin → Mitarbeiter.
ZEITLY_SEED=production
ZEITLY_SEED_SEND=0
# Optional: bootstrap a single organisation + owner instead (only used when ZEITLY_SEED is unset)
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ORG_SLUG=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=
TZ=Europe/Vienna
# --- Ops (compose) ---
ZEITLY_HOST=fairhours.malelu.io
GIT_SHA=
CRON_SECRET=
BACKUP_PASSPHRASE=
BACKUP_RCLONE_REMOTE=
BACKUP_HEALTHCHECK_URL=
