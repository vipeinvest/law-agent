{
  "name": "zeitly",
  "version": "0.1.0",
  "private": true,
  "description": "Zeitly – Arbeitszeiterfassung für Österreich (AZG-konform, Lohnverrechnungs-Export, Multi-Mandant, White-Label).",
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:demo": "ZEITLY_DB=pglite ZEITLY_DEMO=1 next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3000",
    "start:demo": "ZEITLY_DB=pglite ZEITLY_DEMO=1 next start -p 3100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.14",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "exceljs": "4.4.0",
    "lucide-react": "0.468.0",
    "next": "14.2.35",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "4.6.0",
    "server-only": "0.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.19",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
